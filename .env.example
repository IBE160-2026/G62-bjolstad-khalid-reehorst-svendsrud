# Copy to .env before starting: cp .env.example .env
# Every value here is a safe default for running locally. Never commit .env.

# local | test | production. In production the backend refuses to start with the
# default or an empty SESSION_SECRET, and never seeds demo users.
APP_ENV=local

# Secret used for sessions. Fine locally; replace with a long random value elsewhere.
SESSION_SECRET=change-me-local-only

# PostgreSQL container (db service). Used only inside the Docker network.
# These are coupled: user, password and database name must match DATABASE_URL and
# TEST_DATABASE_URL below. Change them together.
POSTGRES_USER=promptforce
POSTGRES_PASSWORD=promptforce
POSTGRES_DB=promptforce

# Backend database connections. "db" is the database service name in docker-compose.yml.
# The test database name (promptforce_test) is fixed: db/init/01-create-test-db.sql creates
# it when the db volume is first created. Tests refuse any database not ending in _test.
DATABASE_URL=postgresql+psycopg://promptforce:promptforce@db:5432/promptforce
TEST_DATABASE_URL=postgresql+psycopg://promptforce:promptforce@db:5432/promptforce_test

# Address the browser uses to open the app (the frontend is the only public port).
APP_URL=http://localhost:3000

# API_INTERNAL_URL (not set here): docker-compose.yml sets it to http://backend:8000 for the
# frontend, and frontend/next.config.ts proxies /api/* there. No need to change it.

# Open Food Facts: mock (no network, default) or live.
OFF_MODE=mock
