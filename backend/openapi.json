{
  "openapi": "3.1.0",
  "info": {
    "title": "Prompt Force API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get Health",
        "description": "Public: no authentication required.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/register": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Register",
        "description": "Public: no authentication required. Creates the account and logs the user in.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/login": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Login",
        "description": "Public: no authentication required. Starts a new session for the account.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/logout": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Logout",
        "description": "Ends only the session of the cookie that was sent.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Me",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "identity"
        ],
        "summary": "Delete Account",
        "description": "Deletes the account (soft delete) and logs out every device. Requires login, not consent.",
        "operationId": "delete_account",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/consent": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Give Consent",
        "description": "Records consent to storing health data. Requires login, not consent.",
        "operationId": "give_consent",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/intro/dismiss": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Dismiss Intro",
        "description": "Records that the first-run introduction was closed. Requires login, not consent.",
        "operationId": "dismiss_intro",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "Get Profile",
        "description": "The user's profile and stored daily target; 404 `profile_not_found` before setup.",
        "operationId": "get_profile",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "profile"
        ],
        "summary": "Save Profile",
        "description": "Create or replace the profile; the target is recomputed and stored on every save.",
        "operationId": "save_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/food/items": {
      "get": {
        "tags": [
          "food"
        ],
        "summary": "Search Food Items",
        "description": "Shared items plus the user's own whose name contains `q`; max 20; `[]` under 2 chars.",
        "operationId": "search_food_items",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": "",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FoodItemResponse"
                  },
                  "title": "Response Search Food Items"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        }
      }
    },
    "/api/food/entries": {
      "get": {
        "tags": [
          "food"
        ],
        "summary": "Get Food Day",
        "description": "The user's entries for one date (YYYY-MM-DD) by Meal, with Meal and day totals.",
        "operationId": "get_food_day",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodDayResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        }
      },
      "post": {
        "tags": [
          "food"
        ],
        "summary": "Add Food Entry",
        "description": "Log grams of a food item in a Meal; kcal per 100 g is copied as a snapshot.",
        "operationId": "add_food_entry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodEntryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodEntryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityLevel": {
        "type": "string",
        "enum": [
          "sedentary",
          "light",
          "moderate",
          "very_active",
          "extremely_active"
        ],
        "title": "ActivityLevel"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "description": "One invalid input field, shown inline under that field in the UI."
      },
      "FoodDayResponse": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "meals": {
            "items": {
              "$ref": "#/components/schemas/MealSummary"
            },
            "type": "array",
            "title": "Meals"
          },
          "total_kcal": {
            "type": "number",
            "title": "Total Kcal"
          }
        },
        "type": "object",
        "required": [
          "date",
          "meals",
          "total_kcal"
        ],
        "title": "FoodDayResponse"
      },
      "FoodEntryRequest": {
        "properties": {
          "food_item_id": {
            "type": "string",
            "format": "uuid",
            "title": "Food Item Id"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "meal": {
            "$ref": "#/components/schemas/Meal"
          },
          "grams": {
            "type": "number",
            "title": "Grams"
          }
        },
        "type": "object",
        "required": [
          "food_item_id",
          "date",
          "meal",
          "grams"
        ],
        "title": "FoodEntryRequest"
      },
      "FoodEntryResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "food_item_id": {
            "type": "string",
            "format": "uuid",
            "title": "Food Item Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "meal": {
            "$ref": "#/components/schemas/Meal"
          },
          "grams": {
            "type": "number",
            "title": "Grams"
          },
          "kcal_per_100g_snapshot": {
            "type": "number",
            "title": "Kcal Per 100G Snapshot"
          },
          "kcal": {
            "type": "number",
            "title": "Kcal"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "food_item_id",
          "name",
          "date",
          "meal",
          "grams",
          "kcal_per_100g_snapshot",
          "kcal",
          "created_at"
        ],
        "title": "FoodEntryResponse"
      },
      "FoodItemResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "source": {
            "$ref": "#/components/schemas/FoodSource"
          },
          "kcal_per_100g": {
            "type": "number",
            "title": "Kcal Per 100G"
          },
          "protein_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protein G"
          },
          "carbs_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carbs G"
          },
          "fat_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fat G"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "source",
          "kcal_per_100g",
          "protein_g",
          "carbs_g",
          "fat_g"
        ],
        "title": "FoodItemResponse"
      },
      "FoodSource": {
        "type": "string",
        "enum": [
          "matvaretabellen",
          "off",
          "user"
        ],
        "title": "FoodSource"
      },
      "Goal": {
        "type": "string",
        "enum": [
          "lose",
          "maintain",
          "gain"
        ],
        "title": "Goal"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "Meal": {
        "type": "string",
        "enum": [
          "breakfast",
          "lunch",
          "dinner",
          "snack"
        ],
        "title": "Meal"
      },
      "MealSummary": {
        "properties": {
          "meal": {
            "$ref": "#/components/schemas/Meal"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FoodEntryResponse"
            },
            "type": "array",
            "title": "Entries"
          },
          "total_kcal": {
            "type": "number",
            "title": "Total Kcal"
          }
        },
        "type": "object",
        "required": [
          "meal",
          "entries",
          "total_kcal"
        ],
        "title": "MealSummary"
      },
      "ProfileRequest": {
        "properties": {
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "weight_kg": {
            "type": "number",
            "title": "Weight Kg"
          },
          "height_cm": {
            "type": "integer",
            "title": "Height Cm"
          },
          "age": {
            "type": "integer",
            "title": "Age"
          },
          "activity_level": {
            "$ref": "#/components/schemas/ActivityLevel"
          },
          "goal": {
            "$ref": "#/components/schemas/Goal"
          }
        },
        "type": "object",
        "required": [
          "sex",
          "weight_kg",
          "height_cm",
          "age",
          "activity_level",
          "goal"
        ],
        "title": "ProfileRequest"
      },
      "ProfileResponse": {
        "properties": {
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "weight_kg": {
            "type": "number",
            "title": "Weight Kg"
          },
          "height_cm": {
            "type": "integer",
            "title": "Height Cm"
          },
          "age": {
            "type": "integer",
            "title": "Age"
          },
          "activity_level": {
            "$ref": "#/components/schemas/ActivityLevel"
          },
          "goal": {
            "$ref": "#/components/schemas/Goal"
          },
          "target_kcal": {
            "type": "integer",
            "title": "Target Kcal"
          },
          "floor_applied": {
            "type": "boolean",
            "title": "Floor Applied"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "sex",
          "weight_kg",
          "height_cm",
          "age",
          "activity_level",
          "goal",
          "target_kcal",
          "floor_applied",
          "updated_at"
        ],
        "title": "ProfileResponse"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "Sex": {
        "type": "string",
        "enum": [
          "female",
          "male"
        ],
        "title": "Sex"
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "consent_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consent At"
          },
          "intro_dismissed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intro Dismissed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "consent_at",
          "intro_dismissed_at"
        ],
        "title": "UserResponse"
      }
    }
  }
}
